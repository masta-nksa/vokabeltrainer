        { "id": "3_2-plurals-12", "type": "gap", "text": "one watch  →  two ___", "answer": "watches", "note": "endet auf -ch  →  -es" },
        { "id": "3_2-plurals-13", "type": "gap", "text": "one brush  →  two ___", "answer": "brushes", "note": "endet auf -sh  →  -es" }
