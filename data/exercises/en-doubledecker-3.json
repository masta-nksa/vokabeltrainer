    {
      "id": "3_3-past-sentences",
      "unitId": "3_3",
      "title": "Unit 3 – Simple Past im Satz",
      "intro": "Setz das Verb in Klammern in die einfache Vergangenheit.",
      "tasks": [
        { "id": "3_3-past-sentences-01", "type": "gap", "text": "Yesterday I ___ (play) football with my friends.", "answer": "played" },
        { "id": "3_3-past-sentences-02", "type": "gap", "text": "She ___ (go) to the swimming pool last week.", "answer": "went" },
        { "id": "3_3-past-sentences-03", "type": "gap", "text": "We ___ (watch) the marathon on TV.", "answer": "watched" },
        { "id": "3_3-past-sentences-04", "type": "gap", "text": "He ___ (be) the winner of the race.", "answer": "was" },
        { "id": "3_3-past-sentences-05", "type": "gap", "text": "They ___ (be) very tired after training.", "answer": "were" },
        { "id": "3_3-past-sentences-06", "type": "gap", "text": "The team ___ (win) the game.", "answer": "won" },
        { "id": "3_3-past-sentences-07", "type": "gap", "text": "My coach ___ (give) me good advice.", "answer": "gave" },
        { "id": "3_3-past-sentences-08", "type": "gap", "text": "I ___ (not / be) at the gym yesterday.", "answer": ["was not", "wasn't"], "note": "not + be  →  was not / wasn't" },
        { "id": "3_3-past-sentences-09", "type": "gap", "text": "She ___ (not / come) to practice.", "answer": ["did not come", "didn't come"], "note": "not + Vollverb  →  didn't + Grundform" },
        { "id": "3_3-past-sentences-10", "type": "gap", "text": "___ you (see) the champion yesterday?", "answer": "Did", "note": "Frage  →  Did + Person + Grundform" }
      ]
    },
